NEXUS_HOST=0.0.0.0
NEXUS_PORT=8787
NEXUS_STATE_DB=state/nexus.db
NEXUS_RUNTIME_STATE_DIR=state/runtime
NEXUS_RUNTIME_MANIFEST=engines.runtime.json
NEXUS_ARTIFACT_DIR=artifacts
NEXUS_EXECUTION_TIMEOUT_SECONDS=120
NEXUS_REQUIRE_APPROVAL_FOR_SIDE_EFFECTS=true

# Non-conflicting endpoints for the native in-repository engine runtime.
NEXUS_OPENMAIC_URL=http://127.0.0.1:3001/api
NEXUS_WEKNORA_URL=http://127.0.0.1:8080/api/v1
NEXUS_GRAPHITI_MCP_URL=http://127.0.0.1:8002/mcp/
NEXUS_COGNEE_URL=http://127.0.0.1:8003
NEXUS_OPEN_WEBUI_URL=http://127.0.0.1:8084/api

# Qwen normally runs through its vendored local CLI/gateway.
# Set this only if you expose a compatible HTTP gateway.
# NEXUS_QWEN_AUDIO_URL=http://127.0.0.1:8765

# Optional command overrides. When omitted, Nexus resolves commands from engines.runtime.json.
# NEXUS_GENOFFICE_COMMAND=
# NEXUS_AGENT_REACH_COMMAND=
# NEXUS_BROWSER_USE_COMMAND=
# NEXUS_QWEN_AUDIO_COMMAND=
