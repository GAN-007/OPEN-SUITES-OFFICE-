NEXUS_HOST=0.0.0.0
NEXUS_PORT=8787
NEXUS_STATE_DB=state/nexus.db
NEXUS_ARTIFACT_DIR=artifacts
NEXUS_EXECUTION_TIMEOUT_SECONDS=120
NEXUS_REQUIRE_APPROVAL_FOR_SIDE_EFFECTS=true

# Optional service endpoints. Leave unset to use the native upstream application directly.
NEXUS_OPENMAIC_URL=http://127.0.0.1:3001
NEXUS_WEKNORA_URL=http://127.0.0.1:8081
NEXUS_GRAPHITI_MCP_URL=http://127.0.0.1:8002/mcp
NEXUS_COGNEE_URL=http://127.0.0.1:8000
NEXUS_OPEN_WEBUI_URL=http://127.0.0.1:8080
NEXUS_QWEN_AUDIO_URL=http://127.0.0.1:8765

# Optional command overrides for pass-through CLI execution.
NEXUS_GENOFFICE_COMMAND=node upstream/genoffice/packages/cli/dist/index.js
NEXUS_AGENT_REACH_COMMAND=python -m agent_reach.cli
NEXUS_BROWSER_USE_COMMAND=browser-use
NEXUS_QWEN_AUDIO_COMMAND=node upstream/qwen-audio-agent/cli/bin/qwen-audio-agent.mjs


# Optional Laya/Jev-compatible System-One routing layer.
# Shadow mode never changes routing. Assist mode can only resolve requests that
# would otherwise fall back to Open WebUI; explicit capability/engine choices win.
NEXUS_SYSTEM_ONE_MODE=off
NEXUS_SYSTEM_ONE_BASE_URL=http://127.0.0.1:8000
NEXUS_SYSTEM_ONE_API_KEY=
NEXUS_SYSTEM_ONE_TIMEOUT_SECONDS=1.5
NEXUS_SYSTEM_ONE_CONFIDENCE_THRESHOLD=0.85


# Shared GAN Decision Plane gateway.
# Other projects should point their existing *_SYSTEM_ONE_BASE_URL at this Nexus
# service, then Nexus forwards the typed /v1/systemone contract to the selected
# provider. Leave fallback blank unless a second provider is configured.
NEXUS_DECISION_PLANE_PRIMARY_PROVIDER=laya
NEXUS_DECISION_PLANE_FALLBACK_PROVIDER=
NEXUS_DECISION_PLANE_TIMEOUT_SECONDS=1.5

# Provider endpoints consumed only by the shared gateway.
NEXUS_LAYA_BASE_URL=http://127.0.0.1:8000
NEXUS_LAYA_API_KEY=
NEXUS_JEV_BASE_URL=
NEXUS_JEV_API_KEY=
