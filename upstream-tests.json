{
  "schema_version": 2,
  "source": "vendored",
  "engines": {
    "genoffice": {
      "path": "engines/genoffice",
      "install": [
        [
          "npm",
          "ci"
        ]
      ],
      "build": [
        [
          "npm",
          "run",
          "build:all"
        ]
      ],
      "test": [
        [
          "npm",
          "test"
        ]
      ]
    },
    "openmaic": {
      "path": "engines/openmaic",
      "install": [
        [
          "corepack",
          "pnpm",
          "install",
          "--frozen-lockfile"
        ]
      ],
      "build": [
        [
          "corepack",
          "pnpm",
          "run",
          "build"
        ]
      ],
      "test": [
        [
          "corepack",
          "pnpm",
          "test"
        ]
      ]
    },
    "weknora": {
      "path": "engines/weknora",
      "install": [
        [
          "go",
          "mod",
          "download"
        ]
      ],
      "build": [
        [
          "go",
          "build",
          "./cmd/server"
        ]
      ],
      "test": [
        [
          "go",
          "test",
          "./..."
        ]
      ]
    },
    "graphiti": {
      "path": "engines/graphiti",
      "install": [
        [
          "uv",
          "sync",
          "--all-extras",
          "--dev"
        ]
      ],
      "build": [],
      "test": [
        [
          "uv",
          "run",
          "pytest"
        ]
      ]
    },
    "cognee": {
      "path": "engines/cognee",
      "install": [
        [
          "uv",
          "sync",
          "--extra",
          "api",
          "--extra",
          "docs",
          "--extra",
          "evals",
          "--extra",
          "ollama",
          "--extra",
          "dev",
          "--extra",
          "neo4j",
          "--extra",
          "redis",
          "--extra",
          "tracing",
          "--extra",
          "postgres",
          "--extra",
          "aws",
          "--extra",
          "neptune",
          "--extra",
          "langchain",
          "--extra",
          "dlt"
        ]
      ],
      "build": [],
      "test": [
        [
          "uv",
          "run",
          "pytest",
          "cognee/tests/unit",
          "--import-mode=importlib"
        ]
      ]
    },
    "browser-use": {
      "path": "engines/browser-use",
      "install": [
        [
          "uv",
          "sync",
          "--all-extras",
          "--dev"
        ]
      ],
      "build": [],
      "test": [
        [
          "uv",
          "run",
          "pytest"
        ]
      ]
    },
    "open-webui": {
      "path": "engines/open-webui",
      "install": [
        [
          "npm",
          "ci"
        ]
      ],
      "build": [
        [
          "bash",
          "-lc",
          "NODE_OPTIONS=--max-old-space-size=6144 npm run build"
        ]
      ],
      "test": [
        [
          "npm",
          "run",
          "test:frontend"
        ]
      ]
    },
    "pageindex": {
      "path": "engines/pageindex",
      "install": [
        [
          "python3",
          "-m",
          "pip",
          "install",
          "-e",
          "."
        ],
        [
          "python3",
          "-m",
          "pip",
          "install",
          "pytest>=7"
        ]
      ],
      "build": [],
      "test": [
        [
          "python3",
          "-m",
          "pytest"
        ]
      ]
    },
    "agent-reach": {
      "path": "engines/agent-reach",
      "install": [
        [
          "python3",
          "-m",
          "pip",
          "install",
          "-e",
          ".[dev]"
        ]
      ],
      "build": [],
      "test": [
        [
          "python3",
          "-m",
          "pytest"
        ]
      ]
    },
    "qwen-audio-agent": {
      "path": "engines/qwen-audio-agent",
      "install": [
        [
          "npm",
          "ci"
        ]
      ],
      "build": [
        [
          "npm",
          "run",
          "build"
        ]
      ],
      "test": [
        [
          "npm",
          "test"
        ]
      ]
    }
